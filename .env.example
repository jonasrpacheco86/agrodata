# AgroData — TEMPLATE de variáveis de ambiente.
# Copie para .env e preencha LOCALMENTE. O .env está no .gitignore e NUNCA vai para
# o repositório/GitHub (ADR-001). Este arquivo (.env.example) tem só placeholders.

# ── PostgreSQL (superusuário — só para bootstrap/migrations) ────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrodata
POSTGRES_USER=agrodata
POSTGRES_PASSWORD=troque-me

# ── Papéis de menor privilégio (ADR-002) — nenhum serviço usa superusuário ──────
# Use senhas URL-safe (sem @ : / ? #): estas viram parte de URIs de conexão.
# Airflow escreve em raw + mart (papel usado na Connection agrodata_dw da DAG):
AIRFLOW_DB_USER=airflow_rw
AIRFLOW_DB_PASSWORD=troque-me
# Metabase lê SOMENTE mart:
METABASE_DB_USER=metabase_ro
METABASE_DB_PASSWORD=troque-me
# Servidor MCP lê SOMENTE as views que expõe:
MCP_DB_USER=mcp_ro
MCP_DB_PASSWORD=troque-me

# ── Servidor MCP ───────────────────────────────────────────────────────────────
# Local (Claude Desktop via stdio): não precisa de nada além de MCP_DB_PASSWORD.
# Deploy público (Render, ver deploy/README.md):
MCP_TRANSPORT=stdio                 # troque para "http" no deploy público
MCP_AUTH_TOKEN=gere-um-token-forte  # bearer obrigatório no modo http (openssl rand -hex 32)
# MCP_DB_URL tem prioridade sobre MCP_DB_* (ex.: string da Neon como mcp_ro, com sslmode=require):
# MCP_DB_URL=postgresql://mcp_ro:senha@host-neon/db?sslmode=require
